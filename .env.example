# Deployment Environment Variables Template
# Copy this file to .env for local testing or configure these in Render's Environment tab.

# Server Port (Render sets this automatically)
PORT=8000
HOST=0.0.0.0

# Python Path
PYTHONPATH=.

# CORS Configuration
# Set to "*" to allow all origins, or comma-separated list of allowed origins:
# e.g., https://job-skill-ontology-frontend.onrender.com,http://localhost:3000
CORS_ORIGINS=*

# Optional Data Storage Directory (Render Persistent Disk)
# When a Render Persistent Disk is attached at /var/data, set:
# DATA_DIR=/var/data
# Default: ./backend/database
DATA_DIR=

# Optional Search & Trust Verification API Keys
GOOGLE_SEARCH_API_KEY=
VERIFICATION_API_KEY=

# Frontend Vite API URL (Only needed when frontend is deployed as a standalone static site)
# e.g., https://job-skill-ontology-backend.onrender.com
VITE_API_URL=
